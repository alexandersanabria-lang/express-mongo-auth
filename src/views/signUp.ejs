<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="auth-shell">
    <section class="auth-panel">
        <h1>Crea tu cuenta</h1>
        <p>Regístrate en un minuto y entra a tu panel.</p>
    </section>

    <section class="auth-form-wrap">
        <div class="auth-card wide">
            <h2>Registro</h2>
            <p class="auth-sub">Completa tus datos para crear la cuenta.</p>

            <form id="signup-form" novalidate>
                <div class="row">
                    <div class="input-field col s12 m6">
                        <input id="name" type="text" autocomplete="given-name">
                        <label for="name">Nombre</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <input id="lastName" type="text" autocomplete="family-name">
                        <label for="lastName">Apellido</label>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12 m6">
                        <input id="phoneNumber" type="tel" autocomplete="tel">
                        <label for="phoneNumber">Teléfono</label>
                    </div>
                    <div class="input-field col s12 m6">
                        <input id="birthdate" type="date">
                        <label for="birthdate" class="active">Fecha de nacimiento</label>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <input id="email" type="email" autocomplete="email">
                        <label for="email">Email</label>
                    </div>
                </div>

                <div class="row">
                    <div class="input-field col s12">
                        <input id="password" type="password" autocomplete="new-password">
                        <label for="password">Contraseña</label>
                        <span class="helper-text">
                            Mínimo 8 caracteres, 1 mayúscula, 1 dígito y 1 especial (# $ % &amp; * @)
                        </span>
                    </div>
                </div>

                <p id="form-error" class="form-error" style="display:none"></p>

                <button type="submit" id="btn-submit" class="btn btn-block">Crear cuenta</button>
            </form>

            <p class="auth-switch">¿Ya tienes cuenta? <a href="/signIn">Inicia sesión</a></p>
        </div>
    </section>
</main>

<%- include('partials/footer') %>