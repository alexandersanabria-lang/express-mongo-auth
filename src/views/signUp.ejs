<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="container page-container">
    <div class="row">
        <div class="col s12 m10 offset-m1 l8 offset-l2">
            <div class="card">
                <div class="card-content">
                    <span class="card-title center-align">Crear cuenta</span>

                    <form id="signup-form" novalidate>
                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input id="name" type="text" autocomplete="given-name">
                                <label for="name">Nombre</label>
                            </div>
                            <div class="input-field col s12 m6">
                                <input id="lastName" type="text" autocomplete="family-name">
                                <label for="lastName">Apellido</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12 m6">
                                <input id="phoneNumber" type="tel" autocomplete="tel">
                                <label for="phoneNumber">Teléfono</label>
                            </div>
                            <div class="input-field col s12 m6">
                                <input id="birthdate" type="date">
                                <label for="birthdate" class="active">Fecha de nacimiento</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <input id="email" type="email" autocomplete="email">
                                <label for="email">Email</label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="input-field col s12">
                                <input id="password" type="password" autocomplete="new-password">
                                <label for="password">Contraseña</label>
                                <span class="helper-text">
                                    Mínimo 8 caracteres, 1 mayúscula, 1 dígito y 1 especial (# $ % &amp; * @)
                                </span>
                            </div>
                        </div>

                        <p id="form-error" class="red-text center-align" style="display:none"></p>

                        <div class="center-align">
                            <button type="submit" id="btn-submit" class="btn teal waves-effect waves-light">Registrarme</button>
                        </div>
                    </form>

                    <p class="center-align" style="margin-top: 20px;">
                        ¿Ya tienes cuenta? <a href="/signIn">Inicia sesión</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>