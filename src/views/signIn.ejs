<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="container page-container">
    <div class="row">
        <div class="col s12 m8 offset-m2 l6 offset-l3">
            <div class="card">
                <div class="card-content">
                    <span class="card-title center-align">Iniciar sesión</span>

                    <form id="signin-form" novalidate>
                        <div class="input-field">
                            <i class="material-icons prefix">email</i>
                            <input id="email" type="email" autocomplete="email">
                            <label for="email">Email</label>
                        </div>

                        <div class="input-field">
                            <i class="material-icons prefix">lock</i>
                            <input id="password" type="password" autocomplete="current-password">
                            <label for="password">Contraseña</label>
                        </div>

                        <p id="form-error" class="red-text center-align" style="display:none"></p>

                        <div class="center-align">
                            <button type="submit" id="btn-submit" class="btn teal waves-effect waves-light">Ingresar</button>
                        </div>
                    </form>

                    <p class="center-align" style="margin-top: 20px;">
                        ¿No tienes cuenta? <a href="/signUp">Regístrate</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>