<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="auth-shell">
    <section class="auth-panel">
        <h1>Entra a tu espacio</h1>
        <p>Inicia sesión para ver tu perfil y tus datos.</p>
    </section>

    <section class="auth-form-wrap">
        <div class="auth-card">
            <h2>Iniciar sesión</h2>
            <p class="auth-sub">Ingresa con tu email y contraseña.</p>

            <form id="signin-form" novalidate>
                <div class="input-field">
                    <i class="material-icons prefix">email</i>
                    <input id="email" type="email" autocomplete="email">
                    <label for="email">Email</label>
                </div>

                <div class="input-field">
                    <i class="material-icons prefix">lock</i>
                    <input id="password" type="password" autocomplete="current-password">
                    <label for="password">Contraseña</label>
                </div>

                <p id="form-error" class="form-error" style="display:none"></p>

                <button type="submit" id="btn-submit" class="btn btn-block">Iniciar sesión</button>
            </form>

            <p class="auth-switch">¿No tienes cuenta? <a href="/signUp">Crea una</a></p>
        </div>
    </section>
</main>

<%- include('partials/footer') %>